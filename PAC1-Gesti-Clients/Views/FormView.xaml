<UserControl x:Class="WPF_MVVM_SPA_Template.Views.FormView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:WPF_MVVM_SPA_Template.Views"
             xmlns:ext="clr-namespace:DLL_AbrilVilalta_MosiesCuartero;assembly=DLL_AbrilVilalta_MosiesCuartero"
             mc:Ignorable="d"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Background="{DynamicResource MainBackgroundBrush}">

        <Grid Background="{DynamicResource MainBackgroundBrush}" Margin="24,20,24,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ══ Header ══ -->
            <StackPanel Grid.Row="0" Margin="0,0,0,24">
                <TextBlock Text="User Management"
                           FontSize="26"
                           FontWeight="Bold"
                           Foreground="{DynamicResource PrimaryTextBrush}"
                           HorizontalAlignment="Left"/>
                <TextBlock Text="{Binding SelectedClient.IdCli, FallbackValue='Creating new user', StringFormat='Editing user #{0}'}"
                           FontSize="13"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           Opacity="0.7"
                           Margin="0,4,0,0"/>
                <!-- Accent line under header -->
                <Rectangle Height="2" Fill="{DynamicResource PrimaryAccentBrush}"
                           HorizontalAlignment="Left" Width="48" Margin="0,10,0,0"
                           Opacity="0.8"/>
            </StackPanel>

            <!-- ══ Form card ══ -->
            <Border Grid.Row="1"
                    Background="{DynamicResource CardBackgroundBrush}"
                    CornerRadius="14"
                    Padding="32,28,32,28"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1">

                <StackPanel>

                    <!-- ── Section label: Personal info ── -->
                    <TextBlock Text="PERSONAL INFORMATION"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Opacity="0.55"
                               Margin="0,0,0,14"/>

                    <!-- ── Row 1: Name + Lastname ── -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Name"
                                       FontSize="12"
                                       FontWeight="Medium"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       Margin="0,0,0,5"/>
                            <ext:MinLengthTextBoxName
                                MinLength="2"
                                Tag="e.g. Manolo"
                                Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Lastname"
                                       FontSize="12"
                                       FontWeight="Medium"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       Margin="0,0,0,5"/>
                            <ext:MinLengthTextBoxSurname
                                MinLength="2"
                                Tag="e.g. Fernandez"
                                Text="{Binding Lastname, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Grid>

                    <!-- ── Row 2: DNI + Phone ── -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="DNI"
                                       FontSize="12"
                                       FontWeight="Medium"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       Margin="0,0,0,5"/>
                            <ext:DNITextBox
                                Mask="00000000A"
                                Tag="12345678Z"
                                Name="DNI"
                                DNI="{Binding DNI, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Phone"
                                       FontSize="12"
                                       FontWeight="Medium"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       Margin="0,0,0,5"/>
                            <ext:PhoneTextBox
                                 Tag="e.g. 612 345 678" Mask="000-000-000" Name="Phone"
                                 Phone = "{Binding Phone, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Grid>

                    <!-- ── Row 3: Email (full width) ── -->
                    <StackPanel Margin="0,0,0,20">
                        <TextBlock Text="Email"
                                   FontSize="12"
                                   FontWeight="Medium"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   Margin="0,0,0,5"/>
                        <ext:EmailTextBox
                            Tag="manolo.fernandez@example.com"
                            Name="Email"
                            Email="{Binding Mail, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <!-- ── Divider ── -->
                    <Rectangle Height="1"
                               Fill="{DynamicResource CardBorderBrush}"
                               Opacity="0.5"
                               Margin="0,0,0,18"/>

                    <!-- ── Created At ── -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                        <TextBlock Text="Created at:"
                                   FontSize="12"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding CreatedAtDisplay, StringFormat='{}{0:dd/MM/yyyy  HH:mm:ss}'}"
                                   Name="CreatedAt"
                                   FontSize="12"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   FontStyle="Italic"
                                   Opacity="0.6"
                                   VerticalAlignment="Center"
                                   Margin="8,0,0,0"/>
                    </StackPanel>

                    <!-- ── Action buttons ── -->
                    <Grid Margin="0,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                            Content="Cancel"
                            Command="{Binding CancelCommand}"
                            Height="40"
                            Padding="20,0"
                            FontSize="{DynamicResource font-size-base}"
                            FontWeight="SemiBold"
                            Style="{StaticResource ModernGhostButtonStyle}"/>

                        <Button Grid.Column="2"
                            Content="Save User"
                            Command="{Binding SendCommand}"
                            Height="40"
                            Padding="28,0"
                            FontSize="{DynamicResource font-size-base}"
                            FontWeight="SemiBold"
                            Style="{StaticResource ModernPrimaryButtonStyle}"/>
                    </Grid>

                </StackPanel>
            </Border>

        </Grid>
    </ScrollViewer>
</UserControl>
